# Workers static assets uploads EVERYTHING under assets.directory (the repo root) unless it is
# listed here. Two kinds of thing are excluded: what is not part of the app, and the one file
# Cloudflare will not take.

# Over Cloudflare's 25 MiB per-asset limit at 25.93 MiB. src/index.js streams it from GitHub
# instead, so the browser still fetches it from this origin.
vendor/onnxruntime-web/1.24.3/ort-wasm-simd-threaded.asyncify.wasm

# The Worker's own source is deployed as code, not served as a file.
src

# Not part of the app.
.git
.github
.gitignore
.assetsignore
.claude
.wrangler
wrangler.jsonc
node_modules
plan
tests
tools
scripts
docs
tmp
AGENTS.md
README.md
.DS_Store
.dev.vars
