{
  // protavia.naklitechie.com — static assets, plus one Worker route that streams the oversized
  // ONNX Runtime WebAssembly binary out of the private repository. See src/index.js for why.
  // account_id is pinned on purpose: this machine has more than one Cloudflare account.
  "name": "protavia",
  "account_id": "62231b040ed00c96cdcf3a4541eab958",
  "compatibility_date": "2026-10-04",
  "main": "src/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "protavia.naklitechie.com", "custom_domain": true }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
